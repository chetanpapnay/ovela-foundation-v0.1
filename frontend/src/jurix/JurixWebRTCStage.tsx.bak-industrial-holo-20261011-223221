import React, { useEffect, useRef } from "react";
import * as THREE from "three";
import { FBXLoader } from "three/examples/jsm/loaders/FBXLoader.js";

export type JurixAvatarMode = "idle" | "greeting" | "listening" | "speaking";

interface JurixWebRTCStageProps {
  mode: JurixAvatarMode;
  presentationTrigger?: number;
  presentationActive?: boolean;
}

export const JurixWebRTCStage: React.FC<JurixWebRTCStageProps> = ({
  mode,
  presentationTrigger = 0,
  presentationActive = false,
}) => {
  const mountRef = useRef<HTMLDivElement>(null);
  const modeRef = useRef<JurixAvatarMode>(mode);
  const playModeRef = useRef<(name: JurixAvatarMode) => void>(() => {});
  const playPresentationRef = useRef<() => void>(() => {});
  const presentationActiveRef = useRef(false);
  const presentationHandRef = useRef<THREE.Object3D | null>(null);
  const holoProjectorRef = useRef<THREE.Group | null>(null);

  useEffect(() => {
    const container = mountRef.current;
    if (!container) return;

    let disposed = false;
    let animId = 0;
    let mixer: THREE.AnimationMixer | null = null;
    let activeAction: THREE.AnimationAction | null = null;

    const actions: Record<string, THREE.AnimationAction> = {};
    const clock = new THREE.Clock();

    const width = container.clientWidth || window.innerWidth;
    const height = container.clientHeight || window.innerHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 1000);
    camera.position.set(0, 1.0, 3.6);
    camera.lookAt(0, 0.8, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    container.innerHTML = "";
    container.appendChild(renderer.domElement);

    scene.add(new THREE.HemisphereLight(0xfff1df, 0x383744, 1.15));

    const keyLight = new THREE.DirectionalLight(0xffe2c4, 2.4);
    keyLight.position.set(1.5, 3.5, 3);
    scene.add(keyLight);

    const faceFillLight = new THREE.DirectionalLight(0xc4dcff, 0.55);
    faceFillLight.position.set(-2.5, 2.2, 3.5);
    scene.add(faceFillLight);

    const rimLight = new THREE.DirectionalLight(0x9ac8ff, 1.05);
    rimLight.position.set(-2.5, 2, -2);
    scene.add(rimLight);

    scene.background = null;

    // ========================================================
    // PROCEDURAL HIGH-RESOLUTION HUD CANVASES
    // ========================================================
    const createCanvasTexture = (w: number, h: number) => {
      const cvs = document.createElement("canvas");
      cvs.width = w;
      cvs.height = h;
      const ctx = cvs.getContext("2d")!;
      const tex = new THREE.CanvasTexture(cvs);
      tex.colorSpace = THREE.SRGBColorSpace;
      return { cvs, ctx, tex };
    };

    // 1. LEFT PANE: LIQUIDITY SPECTRUM
    const leftCanvas = createCanvasTexture(512, 512);
    const renderLeftPanel = (t: number) => {
      const { ctx, cvs } = leftCanvas;
      ctx.clearRect(0, 0, cvs.width, cvs.height);

      // Glassmorphic background gradient
      const bg = ctx.createLinearGradient(0, 0, 0, 512);
      bg.addColorStop(0, "rgba(4, 19, 39, 0.72)");
      bg.addColorStop(1, "rgba(2, 8, 20, 0.88)");
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, 512, 512);

      // Scanline grid
      ctx.strokeStyle = "rgba(56, 189, 248, 0.08)";
      ctx.lineWidth = 1;
      for (let y = 30; y < 512; y += 18) {
        ctx.beginPath();
        ctx.moveTo(20, y);
        ctx.lineTo(492, y);
        ctx.stroke();
      }

      // Border and Header
      ctx.strokeStyle = "rgba(56, 189, 248, 0.4)";
      ctx.lineWidth = 2;
      ctx.strokeRect(10, 10, 492, 492);

      // Neon Top Header
      ctx.fillStyle = "#38bdf8";
      ctx.font = "bold 18px monospace";
      ctx.fillText("SYS:// LIQUIDITY VELOCITY", 26, 42);

      ctx.fillStyle = "rgba(125, 211, 252, 0.65)";
      ctx.font = "12px monospace";
      ctx.fillText("INTERVAL: 100MS | CLUSTER-04", 26, 62);

      // Value Callout
      ctx.fillStyle = "#38bdf8";
      ctx.font = "bold 32px sans-serif";
      ctx.fillText("₹ 4,820M", 26, 110);
      ctx.fillStyle = "#34d399";
      ctx.font = "bold 14px monospace";
      ctx.fillText("+18.4% STABLE", 210, 108);

      // Animated Frequency Bars
      const bars = [0.25, 0.42, 0.65, 0.38, 0.82, 0.95, 0.74, 0.52, 0.88, 0.61, 0.45, 0.3];
      const startX = 35;
      const barW = 28;
      const gap = 10;
      bars.forEach((b, i) => {
        const mod = Math.sin(t * 3.0 + i * 0.8) * 0.08;
        const h = Math.max(0.1, Math.min(1.0, b + mod)) * 230;
        const x = startX + i * (barW + gap);
        const y = 430 - h;

        const grad = ctx.createLinearGradient(0, y, 0, 430);
        if (i === 5) {
          grad.addColorStop(0, "#22d3ee");
          grad.addColorStop(1, "#0284c7");
        } else {
          grad.addColorStop(0, "#38bdf8");
          grad.addColorStop(1, "rgba(14, 116, 144, 0.4)");
        }
        ctx.fillStyle = grad;
        ctx.fillRect(x, y, barW, h);

        // Cap highlight
        ctx.fillStyle = "#e0f2fe";
        ctx.fillRect(x, y, barW, 3);
      });

      // Axis Base
      ctx.strokeStyle = "rgba(56, 189, 248, 0.7)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(25, 432);
      ctx.lineTo(485, 432);
      ctx.stroke();

      // Footer
      ctx.fillStyle = "rgba(148, 163, 184, 0.8)";
      ctx.font = "11px monospace";
      ctx.fillText("TX_FEED_SYNC_OK :: HASH VERIFIED", 26, 475);

      leftCanvas.tex.needsUpdate = true;
    };

    // 2. CENTER PANE: QUANTUM TELEMETRY CORE
    const centerCanvas = createCanvasTexture(512, 512);
    const renderCenterPanel = (t: number) => {
      const { ctx, cvs } = centerCanvas;
      ctx.clearRect(0, 0, cvs.width, cvs.height);

      const bg = ctx.createLinearGradient(0, 0, 0, 512);
      bg.addColorStop(0, "rgba(5, 20, 44, 0.75)");
      bg.addColorStop(1, "rgba(2, 9, 22, 0.90)");
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, 512, 512);

      ctx.strokeStyle = "rgba(56, 189, 248, 0.5)";
      ctx.lineWidth = 2;
      ctx.strokeRect(10, 10, 492, 492);

      // Header
      ctx.fillStyle = "#38bdf8";
      ctx.font = "bold 18px monospace";
      ctx.fillText("CORE RADAR // TARGET LOCK", 26, 42);
      ctx.fillStyle = "#38bdf8";
      ctx.font = "12px monospace";
      ctx.fillText("INVARIANT INTEGRITY: 99.984%", 26, 62);

      // Radar Concentric Rings
      const cx = 256;
      const cy = 270;
      [140, 100, 60, 25].forEach((r, idx) => {
        ctx.strokeStyle = idx === 0 ? "rgba(56, 189, 248, 0.7)" : "rgba(56, 189, 248, 0.25)";
        ctx.lineWidth = idx === 0 ? 2 : 1;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
      });

      // Rotating Radar Sweep Line
      const sweepAngle = t * 1.8;
      ctx.strokeStyle = "rgba(56, 189, 248, 0.85)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(sweepAngle) * 140, cy + Math.sin(sweepAngle) * 140);
      ctx.stroke();

      // Swept Gradient Arc
      const gradSweep = ctx.createRadialGradient(cx, cy, 10, cx, cy, 140);
      gradSweep.addColorStop(0, "rgba(56, 189, 248, 0.25)");
      gradSweep.addColorStop(1, "transparent");
      ctx.fillStyle = gradSweep;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, 140, sweepAngle - 0.6, sweepAngle);
      ctx.closePath();
      ctx.fill();

      // Crosshairs & Reticle Ticks
      ctx.strokeStyle = "rgba(125, 211, 252, 0.45)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - 155, cy);
      ctx.lineTo(cx + 155, cy);
      ctx.moveTo(cx, cy - 155);
      ctx.lineTo(cx, cy + 155);
      ctx.stroke();

      // Status Badge
      ctx.fillStyle = "rgba(34, 197, 94, 0.15)";
      ctx.fillRect(170, 440, 172, 34);
      ctx.strokeStyle = "#22c55e";
      ctx.strokeRect(170, 440, 172, 34);
      ctx.fillStyle = "#4ade80";
      ctx.font = "bold 13px monospace";
      ctx.fillText("● SETTLED COMMITTED", 182, 462);

      centerCanvas.tex.needsUpdate = true;
    };

    // 3. RIGHT PANE: VARIANCE DRIFT WAVE
    const rightCanvas = createCanvasTexture(512, 512);
    const renderRightPanel = (t: number) => {
      const { ctx, cvs } = rightCanvas;
      ctx.clearRect(0, 0, cvs.width, cvs.height);

      const bg = ctx.createLinearGradient(0, 0, 0, 512);
      bg.addColorStop(0, "rgba(30, 10, 42, 0.75)");
      bg.addColorStop(1, "rgba(10, 3, 20, 0.90)");
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, 512, 512);

      ctx.strokeStyle = "rgba(217, 70, 239, 0.45)";
      ctx.lineWidth = 2;
      ctx.strokeRect(10, 10, 492, 492);

      // Header
      ctx.fillStyle = "#e879f9";
      ctx.font = "bold 18px monospace";
      ctx.fillText("TELEMETRY // DRIFT FLUX", 26, 42);
      ctx.fillStyle = "rgba(244, 114, 182, 0.65)";
      ctx.font = "12px monospace";
      ctx.fillText("VOLATILITY INDEX: 0.042 σ", 26, 62);

      // Big Metric
      ctx.fillStyle = "#f472b6";
      ctx.font = "bold 32px sans-serif";
      ctx.fillText("99.984 %", 26, 110);
      ctx.fillStyle = "#a855f7";
      ctx.font = "bold 13px monospace";
      ctx.fillText("ZKP INVARIANT: ZERO LOSS", 200, 108);

      // Sine Waveform with Gradient Fill
      ctx.beginPath();
      ctx.moveTo(30, 320);
      for (let x = 30; x <= 480; x += 5) {
        const rad = (x - 30) * 0.04 + t * 4;
        const y = 320 + Math.sin(rad) * 45 + Math.cos(rad * 0.5) * 20;
        ctx.lineTo(x, y);
      }
      ctx.strokeStyle = "#e879f9";
      ctx.lineWidth = 3;
      ctx.stroke();

      // Lower secondary wave
      ctx.beginPath();
      ctx.moveTo(30, 340);
      for (let x = 30; x <= 480; x += 5) {
        const rad = (x - 30) * 0.05 - t * 3;
        const y = 340 + Math.sin(rad) * 25;
        ctx.lineTo(x, y);
      }
      ctx.strokeStyle = "rgba(56, 189, 248, 0.5)";
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Threshold line
      ctx.strokeStyle = "rgba(239, 68, 68, 0.6)";
      ctx.setLineDash([6, 4]);
      ctx.beginPath();
      ctx.moveTo(30, 240);
      ctx.lineTo(480, 240);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = "#f87171";
      ctx.font = "11px monospace";
      ctx.fillText("MAX TOLERANCE THRESHOLD [0.08 σ]", 260, 234);

      // Footer
      ctx.fillStyle = "rgba(226, 232, 240, 0.75)";
      ctx.font = "11px monospace";
      ctx.fillText("LATENCY: 4.2MS | CIPHER SUITE: KYBER-1024", 26, 475);

      rightCanvas.tex.needsUpdate = true;
    };

    // ========================================================
    // 3D PROJECTOR & VOLUMETRIC HUD SCENE ASSEMBLY
    // Position locked at exact anchor: (-1.05, -0.34, -0.95)
    // ========================================================
    const projectorGroup = new THREE.Group();
    projectorGroup.name = "JurixFloorHoloProjector";
    projectorGroup.position.set(-1.05, -0.34, -0.95);
    projectorGroup.visible = false;
    scene.add(projectorGroup);
    holoProjectorRef.current = projectorGroup;

    // 1. Sleek Floor Pedestal Plinth
    const plinthMat = new THREE.MeshStandardMaterial({
      color: 0x070d18,
      metalness: 0.95,
      roughness: 0.18,
    });
    const outerBase = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.32, 0.03, 48), plinthMat);
    outerBase.position.y = 0.015;
    projectorGroup.add(outerBase);

    // Cyan Neon Inset Ring
    const neonRing = new THREE.Mesh(
      new THREE.RingGeometry(0.20, 0.23, 48),
      new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide })
    );
    neonRing.rotation.x = -Math.PI / 2;
    neonRing.position.y = 0.031;
    projectorGroup.add(neonRing);

    // Inner Titanium Core
    const innerPlinth = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.20, 0.02, 36), plinthMat);
    innerPlinth.position.y = 0.035;
    projectorGroup.add(innerPlinth);

    // Glowing Emitter Aperture Lens
    const lensDisc = new THREE.Mesh(
      new THREE.CircleGeometry(0.12, 32),
      new THREE.MeshBasicMaterial({
        color: 0xe0f7ff,
        transparent: true,
        opacity: 0.95,
      })
    );
    lensDisc.rotation.x = -Math.PI / 2;
    lensDisc.position.y = 0.046;
    projectorGroup.add(lensDisc);

    // Concentrated Vertical Laser Beam Column
    const beamColumnMat = new THREE.MeshBasicMaterial({
      color: 0x0284c7,
      transparent: true,
      opacity: 0.16,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
      depthWrite: false,
    });
    const beamColumn = new THREE.Mesh(
      new THREE.CylinderGeometry(0.72, 0.12, 1.10, 36, 1, true),
      beamColumnMat
    );
    beamColumn.name = "HoloBeamColumn";
    beamColumn.position.y = 0.58;
    projectorGroup.add(beamColumn);

    // 4 Corner Laser Guide Emitter Rails
    const cornerRailsGeo = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(0, 0.045, 0), new THREE.Vector3(-0.80, 1.15, -0.05),
      new THREE.Vector3(0, 0.045, 0), new THREE.Vector3(0.80, 1.15, -0.05),
      new THREE.Vector3(0, 0.045, 0), new THREE.Vector3(-0.80, 0.65, 0.08),
      new THREE.Vector3(0, 0.045, 0), new THREE.Vector3(0.80, 0.65, 0.08),
    ]);
    const cornerRails = new THREE.LineSegments(
      cornerRailsGeo,
      new THREE.LineBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.45,
        blending: THREE.AdditiveBlending,
      })
    );
    projectorGroup.add(cornerRails);

    // Rising Particle Cloud
    const particleCount = 280;
    const particleGeo = new THREE.BufferGeometry();
    const particlePos = new Float32Array(particleCount * 3);
    const particleSpeed: number[] = [];
    for (let i = 0; i < particleCount; i++) {
      const h = Math.random() * 1.05;
      const r = (h / 1.05) * 0.45;
      const theta = Math.random() * Math.PI * 2;
      particlePos[i * 3] = Math.cos(theta) * r;
      particlePos[i * 3 + 1] = 0.05 + h;
      particlePos[i * 3 + 2] = Math.sin(theta) * (r * 0.25);
      particleSpeed.push(0.003 + Math.random() * 0.005);
    }
    particleGeo.setAttribute("position", new THREE.BufferAttribute(particlePos, 3));
    const particlePoints = new THREE.Points(
      particleGeo,
      new THREE.PointsMaterial({
        color: 0x7dd3fc,
        size: 0.011,
        transparent: true,
        opacity: 0.75,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      })
    );
    particlePoints.name = "HoloBeamParticles";
    projectorGroup.add(particlePoints);

    // Point Light Core
    const beamLight = new THREE.PointLight(0x38bdf8, 1.6, 2.5);
    beamLight.position.y = 0.25;
    projectorGroup.add(beamLight);

    // 2. CURVED HOLOGRAPHIC DISPLAY ARRAY
    const holoArray = new THREE.Group();
    holoArray.name = "FloatingHoloPanels";
    holoArray.position.set(0, 1.15, 0.02);
    projectorGroup.add(holoArray);

    const makePane = (map: THREE.CanvasTexture, w: number, h: number) => {
      const mat = new THREE.MeshBasicMaterial({
        map,
        transparent: true,
        opacity: 0.95,
        side: THREE.DoubleSide,
        depthWrite: false,
      });
      return new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);
    };

    // Center Display Panel
    const centerMesh = makePane(centerCanvas.tex, 0.58, 0.52);
    centerMesh.position.set(0, 0, 0);
    holoArray.add(centerMesh);

    // Left Display Panel (Curved Inward)
    const leftMesh = makePane(leftCanvas.tex, 0.50, 0.46);
    leftMesh.position.set(-0.52, 0, 0.08);
    leftMesh.rotation.y = 0.32;
    holoArray.add(leftMesh);

    // Right Display Panel (Curved Inward)
    const rightMesh = makePane(rightCanvas.tex, 0.50, 0.46);
    rightMesh.position.set(0.52, 0, 0.08);
    rightMesh.rotation.y = -0.32;
    holoArray.add(rightMesh);

    // Glowing Holographic Framing Brackets (Top & Bottom)
    const bracketGeo = new THREE.BufferGeometry().setFromPoints([
      // Top curve rail
      new THREE.Vector3(-0.75, 0.27, 0.12),
      new THREE.Vector3(-0.29, 0.27, 0.01),
      new THREE.Vector3(0.29, 0.27, 0.01),
      new THREE.Vector3(0.75, 0.27, 0.12),
      // Bottom curve rail
      new THREE.Vector3(-0.75, -0.27, 0.12),
      new THREE.Vector3(-0.29, -0.27, 0.01),
      new THREE.Vector3(0.29, -0.27, 0.01),
      new THREE.Vector3(0.75, -0.27, 0.12),
    ]);
    const bracketLines = new THREE.LineSegments(
      bracketGeo,
      new THREE.LineBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.85,
        blending: THREE.AdditiveBlending,
      })
    );
    holoArray.add(bracketLines);

    // ==========================================
    // FBX AVATAR AND ANIMATION CONTROLLER
    // ==========================================
    const fbxLoader = new FBXLoader();

    const playMode = (requestedMode: JurixAvatarMode, duration = 0.35) => {
      const actionName = requestedMode === "speaking" ? "talking" : requestedMode;
      const next = actions[actionName];
      if (!next || activeAction === next) return;

      if (activeAction) activeAction.crossFadeTo(next, duration, true);
      next.reset().fadeIn(duration).play();
      activeAction = next;
    };
    playModeRef.current = (requestedMode) => playMode(requestedMode);

    playPresentationRef.current = () => {
      const next = actions.present;
      if (!next || !mixer || disposed) return;

      const hand = presentationHandRef.current;
      const palmHud = hand?.getObjectByName("JurixPalmHologram");
      if (palmHud) palmHud.visible = true;
      if (holoProjectorRef.current) holoProjectorRef.current.visible = true;

      mixer.stopAllAction();
      next.enabled = true;
      next.setLoop(THREE.LoopOnce, 1);
      next.clampWhenFinished = true;
      next.reset().fadeIn(0.25).play();
      activeAction = next;
      presentationActiveRef.current = true;
    };

    fbxLoader.load(
      "/models/jurix_original_rigged_v1.fbx",
      (model) => {
        if (disposed) return;

        model.name = "JurixOriginalRigged";
        model.traverse((obj) => {
          const mesh = obj as THREE.Mesh;
          if (!mesh.isMesh) return;
          mesh.castShadow = true;
          mesh.receiveShadow = true;
          const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
          materials.forEach((material) => {
            if (material instanceof THREE.MeshStandardMaterial) {
              material.roughness = Math.max(material.roughness, 0.82);
              material.metalness = Math.min(material.metalness, 0.06);
              material.needsUpdate = true;
            }
          });
        });

        model.updateMatrixWorld(true);
        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        const scale = 1.62 / (size.y || 1);
        model.scale.setScalar(scale);
        model.position.set(-center.x * scale + 0.82, -box.min.y * scale - 0.2, -center.z * scale - 0.22);
        scene.add(model);

        presentationHandRef.current =
          model.getObjectByName("mixamorigLeftHand") ||
          model.getObjectByName("mixamorigRightHand") ||
          null;

        if (presentationHandRef.current) {
          const palmHud = new THREE.Group();
          palmHud.name = "JurixPalmHologram";
          palmHud.visible = presentationActiveRef.current;
          palmHud.position.set(0, 0.075, 0.045);
          palmHud.rotation.set(-0.72, 0, 0);
          palmHud.scale.setScalar(0.9);
          presentationHandRef.current.add(palmHud);

          const orbParticles = 2600;
          const pGeo = new THREE.BufferGeometry();
          const pPos = new Float32Array(orbParticles * 3);
          const pCol = new Float32Array(orbParticles * 3);
          const cyanC = new THREE.Color(0x38bdf8);
          const indigoC = new THREE.Color(0x818cf8);
          const magentaC = new THREE.Color(0xf43f5e);
          const tmpC = new THREE.Color();

          for (let i = 0; i < orbParticles; i++) {
            const u = Math.random();
            const v = Math.random();
            const theta = u * 2.0 * Math.PI;
            const phi = Math.acos(2.0 * v - 1.0);
            const r = 0.115 + (Math.random() - 0.5) * 0.025;

            pPos[i * 3] = r * Math.sin(phi) * Math.cos(theta);
            pPos[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            pPos[i * 3 + 2] = r * Math.cos(phi) + 0.018;

            const distRatio = THREE.MathUtils.clamp((pPos[i * 3 + 1] + 0.12) / 0.24, 0, 1);
            tmpC.copy(cyanC).lerp(indigoC, distRatio);
            if (pPos[i * 3] < -0.02) tmpC.lerp(magentaC, 0.45);

            pCol[i * 3] = tmpC.r;
            pCol[i * 3 + 1] = tmpC.g;
            pCol[i * 3 + 2] = tmpC.b;
          }

          pGeo.setAttribute("position", new THREE.BufferAttribute(pPos, 3));
          pGeo.setAttribute("color", new THREE.BufferAttribute(pCol, 3));

          const orbMesh = new THREE.Points(
            pGeo,
            new THREE.PointsMaterial({
              size: 0.0055,
              vertexColors: true,
              transparent: true,
              opacity: 0.75,
              blending: THREE.AdditiveBlending,
              depthWrite: false,
              sizeAttenuation: true,
            })
          );
          palmHud.add(orbMesh);

          const coreM = new THREE.Mesh(
            new THREE.SphereGeometry(0.038, 32, 32),
            new THREE.MeshBasicMaterial({
              color: 0xe0f7ff,
              transparent: true,
              opacity: 0.45,
              blending: THREE.AdditiveBlending,
            })
          );
          coreM.position.z = 0.018;
          palmHud.add(coreM);

          const ringConfigs = [
            { radius: 0.145, color: 0x38bdf8, tiltX: 0.22, tiltY: 0.15 },
            { radius: 0.178, color: 0xa855f7, tiltX: -0.48, tiltY: 0.32 },
            { radius: 0.210, color: 0xec4899, tiltX: 0.75, tiltY: -0.28 },
          ];

          ringConfigs.forEach(({ radius, color, tiltX, tiltY }, idx) => {
            const pts: THREE.Vector3[] = [];
            for (let i = 0; i <= 128; i++) {
              const a = (i / 128) * Math.PI * 2;
              pts.push(new THREE.Vector3(Math.cos(a) * radius, Math.sin(a) * radius * 0.88, 0.02 + idx * 0.003));
            }
            const rLine = new THREE.Line(
              new THREE.BufferGeometry().setFromPoints(pts),
              new THREE.LineBasicMaterial({
                color,
                transparent: true,
                opacity: 0.55,
                blending: THREE.AdditiveBlending,
              })
            );
            rLine.name = "PalmEnergyRing";
            rLine.rotation.x = tiltX;
            rLine.rotation.y = tiltY;
            palmHud.add(rLine);
          });
        }

        mixer = new THREE.AnimationMixer(model);

        const animationFiles = [
          { name: "idle", file: "/models/jurix_idle_v1.fbx", loop: THREE.LoopRepeat },
          { name: "greeting", file: "/models/jurix_greeting_v1.fbx", loop: THREE.LoopOnce },
          { name: "listening", file: "/models/jurix_listening_v1.fbx", loop: THREE.LoopRepeat },
          { name: "talking", file: "/models/jurix_talking_v1.fbx", loop: THREE.LoopRepeat },
          { name: "present", file: "/models/jurix_present_tablet.fbx", loop: THREE.LoopOnce },
        ] as const;

        mixer.addEventListener("finished", (event) => {
          if (disposed) return;
          if (event.action === actions.greeting) playMode("idle");
          if (event.action === actions.present) {
            presentationActiveRef.current = false;
            const palmHud = presentationHandRef.current?.getObjectByName("JurixPalmHologram");
            if (palmHud) palmHud.visible = false;
            if (holoProjectorRef.current) holoProjectorRef.current.visible = false;
            playMode("idle");
          }
        });

        animationFiles.forEach(({ name, file, loop }) => {
          fbxLoader.load(
            file,
            (animationFbx) => {
              if (disposed || !mixer) return;
              if (animationFbx.animations.length === 0) return;

              const clip = animationFbx.animations[0].clone();
              const action = mixer.clipAction(clip);
              action.setLoop(loop, loop === THREE.LoopOnce ? 1 : Infinity);
              if (loop === THREE.LoopOnce) action.clampWhenFinished = name === "present";
              actions[name] = action;
              if (name === "present" && presentationActiveRef.current) {
                playPresentationRef.current();
              }
              if (
                name === "idle" ||
                modeRef.current === name ||
                (modeRef.current === "speaking" && name === "talking")
              ) {
                playMode(modeRef.current);
              }
            },
            undefined,
            (error) => console.error("Failed to load Jurix animation:", file, error)
          );
        });
      },
      undefined,
      (error) => console.error("Failed to load rigged Jurix FBX:", error)
    );

    let lastFrameTime = 0;
    const frameInterval = 1000 / 30;

    const animate = (timestamp: number) => {
      if (disposed) return;
      animId = requestAnimationFrame(animate);

      if (timestamp - lastFrameTime < frameInterval) return;

      const delta = Math.min(clock.getDelta(), 0.05);
      const elapsed = clock.getElapsedTime();
      lastFrameTime = timestamp;
      mixer?.update(delta);

      // Animate Palm Hologram
      const palmHud = presentationHandRef.current?.getObjectByName("JurixPalmHologram");
      if (palmHud && palmHud.visible) {
        let rIndex = 0;
        palmHud.children.forEach((child) => {
          if (child.name === "PalmEnergyRing") {
            child.rotation.z += delta * (rIndex % 2 === 0 ? 0.42 : -0.35);
            rIndex++;
          }
        });
      }

      // Animate Holographic Projector & Render HUD Canvases
      const projector = holoProjectorRef.current;
      if (projector && projector.visible) {
        // Redraw dynamic HUD textures
        renderLeftPanel(elapsed);
        renderCenterPanel(elapsed);
        renderRightPanel(elapsed);

        // Subtle atmospheric breathing motion
        const panels = projector.getObjectByName("FloatingHoloPanels");
        if (panels) {
          panels.position.y = 1.15 + Math.sin(timestamp * 0.002) * 0.008;
        }

        // Particle stream cycling
        const pObj = projector.getObjectByName("HoloBeamParticles") as THREE.Points | undefined;
        if (pObj) {
          const attr = pObj.geometry.getAttribute("position") as THREE.BufferAttribute;
          const arr = attr.array as Float32Array;
          for (let i = 0; i < particleCount; i++) {
            arr[i * 3 + 1] += particleSpeed[i];
            if (arr[i * 3 + 1] > 1.10) {
              arr[i * 3 + 1] = 0.05;
              const th = Math.random() * Math.PI * 2;
              const r = Math.random() * 0.08;
              arr[i * 3] = Math.cos(th) * r;
              arr[i * 3 + 2] = Math.sin(th) * (r * 0.25);
            }
          }
          attr.needsUpdate = true;
        }
      }

      renderer.render(scene, camera);
    };
    animId = requestAnimationFrame(animate);

    const handleResize = () => {
      const w = container.clientWidth || window.innerWidth;
      const h = container.clientHeight || window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };

    window.addEventListener("resize", handleResize);

    return () => {
      disposed = true;
      window.removeEventListener("resize", handleResize);
      cancelAnimationFrame(animId);
      mixer?.stopAllAction();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }, []);

  useEffect(() => {
    if (!presentationActiveRef.current) playModeRef.current(mode);
  }, [mode]);

  useEffect(() => {
    presentationActiveRef.current = presentationActive;
    const hand = presentationHandRef.current;
    const palmHud = hand?.getObjectByName("JurixPalmHologram");
    if (palmHud) palmHud.visible = presentationActive;
    if (holoProjectorRef.current) holoProjectorRef.current.visible = presentationActive;
    if (!presentationActive) {
      playModeRef.current("idle");
    }
  }, [presentationActive]);

  useEffect(() => {
    if (presentationTrigger > 0) {
      playPresentationRef.current();
    }
  }, [presentationTrigger]);

  return (
    <div className="relative w-full h-full flex items-center justify-center pointer-events-none">
      <div ref={mountRef} className="w-full h-full pointer-events-auto" />
    </div>
  );
};