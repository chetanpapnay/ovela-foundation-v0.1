import React, { useEffect, useRef } from "react";
import * as THREE from "three";
import { FBXLoader } from "three/examples/jsm/loaders/FBXLoader.js";
import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";

export type JurixAvatarMode = "idle" | "greeting" | "listening" | "speaking";

interface JurixWebRTCStageProps {
  mode: JurixAvatarMode;
}

export const JurixWebRTCStage: React.FC<JurixWebRTCStageProps> = ({ mode }) => {
  const mountRef = useRef<HTMLDivElement>(null);
  const modeRef = useRef<JurixAvatarMode>(mode);

  modeRef.current = mode;

  useEffect(() => {
    const container = mountRef.current;
    if (!container) return;

    let disposed = false;
    let animId = 0;
    let mixer: THREE.AnimationMixer | null = null;
    let activeAction: THREE.AnimationAction | null = null;

    const actions: Record<string, THREE.AnimationAction> = {};
    const clock = new THREE.Clock();

    const width = container.clientWidth || window.innerWidth;
    const height = container.clientHeight || window.innerHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 1000);
    camera.position.set(0, 1.0, 3.6);
    camera.lookAt(0, 0.8, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(1);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    container.innerHTML = "";
    container.appendChild(renderer.domElement);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x1e293b, 2.2));

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(1.5, 3.5, 3);
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 2.0);
    rimLight.position.set(-2.5, 2, -2);
    scene.add(rimLight);
    // JURIX_OFFICE_ENVIRONMENT_V1
    // First-pass executive office: real geometry, layered skyline and warm lights.
    scene.background = new THREE.Color(0x182432);

    const officeRoot = new THREE.Group();
    officeRoot.name = "JurixExecutiveOffice";
    scene.add(officeRoot);

    const officeFloor = new THREE.Mesh(
      new THREE.PlaneGeometry(22, 22),
      new THREE.MeshStandardMaterial({
        color: 0x555963,
        roughness: 0.28,
        metalness: 0.18
      })
    );
    officeFloor.rotation.x = -Math.PI / 2;
    officeFloor.position.set(0, -0.225, -1);
    officeFloor.name = "OfficeReflectiveFloor";
    officeRoot.add(officeFloor);

    const officeMaterials = {
      frame: new THREE.MeshStandardMaterial({
        color: 0x252c35,
        metalness: 0.65,
        roughness: 0.3
      }),
      glass: new THREE.MeshStandardMaterial({
        color: 0x7ca8c7,
        emissive: 0x172c42,
        emissiveIntensity: 0.35,
        metalness: 0.25,
        roughness: 0.18,
        transparent: true,
        opacity: 0.22,
        side: THREE.DoubleSide,
        depthWrite: false
      }),
      wall: new THREE.MeshStandardMaterial({
        color: 0x303641,
        roughness: 0.72,
        metalness: 0.12
      }),
      desk: new THREE.MeshStandardMaterial({
        color: 0x25272c,
        roughness: 0.25,
        metalness: 0.25
      }),
      warm: new THREE.MeshStandardMaterial({
        color: 0xffd8a0,
        emissive: 0xffa94d,
        emissiveIntensity: 1.6,
        roughness: 0.35
      }),
      building: [
        0x293b50, 0x33485d, 0x263344, 0x405063
      ].map(color => new THREE.MeshStandardMaterial({
        color,
        roughness: 0.82,
        metalness: 0.08
      }))
    };

    const addOfficeBox = (
      name: string,
      width: number,
      height: number,
      depth: number,
      x: number,
      y: number,
      z: number,
      material: THREE.Material,
      parent: THREE.Group = officeRoot
    ) => {
      const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(width, height, depth),
        material
      );
      mesh.name = name;
      mesh.position.set(x, y, z);
      parent.add(mesh);
      return mesh;
    };

    // Architectural side piers and top beam frame the window wall.
    addOfficeBox("LeftStonePier", 0.34, 5.2, 0.34, -4.3, 2.35, -4.1, officeMaterials.wall);
    addOfficeBox("RightStonePier", 0.34, 5.2, 0.34, 4.3, 2.35, -4.1, officeMaterials.wall);
    addOfficeBox("WindowTopBeam", 8.9, 0.24, 0.38, 0, 4.85, -4.1, officeMaterials.frame);
    addOfficeBox("WindowBottomSill", 8.6, 0.13, 0.38, 0, 0.0, -4.1, officeMaterials.frame);

    // Glass panes sit behind the structural mullions.
    for (let i = 0; i < 4; i++) {
      const x = -3.2 + i * 2.13;
      const pane = new THREE.Mesh(
        new THREE.PlaneGeometry(2.08, 4.65),
        officeMaterials.glass
      );
      pane.name = "OfficeGlassPane_" + i;
      pane.position.set(x, 2.4, -4.18);
      officeRoot.add(pane);
    }

    for (let i = 0; i < 5; i++) {
      const x = -4.25 + i * 2.125;
      addOfficeBox(
        "WindowVerticalFrame_" + i,
        0.065, 4.75, 0.09,
        x, 2.4, -4.08, officeMaterials.frame
      );
    }

    addOfficeBox("WindowHorizontalFrame", 8.55, 0.055, 0.09, 0, 2.35, -4.08, officeMaterials.frame);

    // A second architectural layer adds depth at the sides.
    addOfficeBox("LeftInteriorWall", 2.0, 4.5, 0.28, -5.1, 2.0, -2.8, officeMaterials.wall);
    addOfficeBox("RightInteriorWall", 2.0, 4.5, 0.28, 5.1, 2.0, -2.8, officeMaterials.wall);

    // Layered city skyline outside the windows, with restrained lit windows.
    const skyline = new THREE.Group();
    skyline.name = "OfficeDistantCity";
    officeRoot.add(skyline);

    const buildings = [
      [-4.0, 1.4, 0.55, 0.55], [-3.35, 2.0, 0.62, 0.6],
      [-2.65, 1.1, 0.5, 0.55], [-2.0, 2.6, 0.72, 0.65],
      [-1.2, 1.65, 0.58, 0.5], [-0.45, 2.25, 0.65, 0.65],
      [0.35, 1.25, 0.5, 0.55], [1.0, 2.8, 0.7, 0.6],
      [1.8, 1.8, 0.58, 0.6], [2.5, 2.35, 0.72, 0.65],
      [3.3, 1.5, 0.6, 0.55], [4.0, 2.1, 0.62, 0.6]
    ];

    buildings.forEach((b, i) => {
      const [x, height, width, depth] = b;
      const building = new THREE.Mesh(
        new THREE.BoxGeometry(width, height, depth),
        officeMaterials.building[i % officeMaterials.building.length]
      );
      building.name = "CityTower_" + i;
      building.position.set(x, 0.02 + height / 2, -6.1 - (i % 3) * 0.35);
      skyline.add(building);

      // Sparse glowing windows on the face toward Jurix.
      const rows = Math.max(2, Math.floor(height * 3));
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < 2; col++) {
          if ((i + row + col) % 3 === 0) continue;
          const windowMesh = new THREE.Mesh(
            new THREE.PlaneGeometry(0.055, 0.075),
            officeMaterials.warm
          );
          windowMesh.position.set(
            x - 0.11 + col * 0.22,
            0.12 + row * 0.22,
            building.position.z + depth / 2 + 0.006
          );
          skyline.add(windowMesh);
        }
      }
    });

    // Executive desk positioned well to the left of Jurix.
    addOfficeBox("ExecutiveDeskTop", 1.65, 0.1, 0.72, -2.05, 1.0, -0.75, officeMaterials.desk);
    addOfficeBox("ExecutiveDeskLegLeft", 0.09, 0.95, 0.62, -2.68, 0.49, -0.75, officeMaterials.frame);
    addOfficeBox("ExecutiveDeskLegRight", 0.09, 0.95, 0.62, -1.42, 0.49, -0.75, officeMaterials.frame);

    // Warm architectural light strips on the side piers.
    addOfficeBox("LeftWarmLightStrip", 0.035, 3.5, 0.025, -4.11, 2.25, -3.9, officeMaterials.warm);
    addOfficeBox("RightWarmLightStrip", 0.035, 3.5, 0.025, 4.11, 2.25, -3.9, officeMaterials.warm);

    const officeWarmLight = new THREE.PointLight(0xffd2a1, 2.0, 12);
    officeWarmLight.position.set(-2.4, 3.0, 1.0);
    officeRoot.add(officeWarmLight);

    const officeFillLight = new THREE.PointLight(0xb6dcff, 1.1, 14);
    officeFillLight.position.set(2.5, 2.8, -1.0);
    officeRoot.add(officeFillLight);


    const fbxLoader = new FBXLoader();
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath("https://www.gstatic.com/draco/versioned/decoders/1.5.7/");
    const gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    const playMode = (name: string, duration = 0.35) => {
      const next = actions[name];
      if (!next || activeAction === next) return;

      if (activeAction) {
        activeAction.crossFadeTo(next, duration, true);
      }

      next.reset().fadeIn(duration).play();
      activeAction = next;
    };

    gltfLoader.load(
      "/models/jurix_v2_standing_idle_textured.glb",
      (gltf) => {
        const model = gltf.scene;
        const embeddedAnimations = gltf.animations;
        if (disposed) return;

        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());

        const scale = 1.8 / (size.y || 1);
        model.scale.setScalar(scale);
        model.position.set(
          -center.x * scale,
          -box.min.y * scale - 0.2,
          -center.z * scale
        );

        model.traverse((obj) => {
          if ((obj as THREE.SkinnedMesh).isSkinnedMesh) {
            const skinned = obj as THREE.SkinnedMesh;
            console.log(
              "JURIX RIG BONES:",
              skinned.skeleton.bones.map((bone) => bone.name)
            );
          }
        });

        scene.add(model);
        mixer = new THREE.AnimationMixer(model);

        // Use the standing-idle animation included in the downloaded FBX.
        if (embeddedAnimations.length > 0) {
          const idleClip = embeddedAnimations[0];
          const idle = mixer.clipAction(idleClip);
          idle.setLoop(THREE.LoopRepeat, Infinity);
          actions.idle = idle;
          idle.play();
          activeAction = idle;
          console.log("JURIX EMBEDDED ANIMATION:", idleClip.name);
        } else {
          console.warn("The optimized GLB contains no embedded animation.");
        }

        const extraAnimations = [
          { name: "greeting", file: "/models/jurix_greeting_new.fbx", loop: THREE.LoopOnce },
          { name: "listening", file: "/models/jurix_listening.fbx", loop: THREE.LoopRepeat },
          { name: "speaking", file: "/models/jurix_talking_new.fbx", loop: THREE.LoopRepeat },
        ];

        extraAnimations.forEach(({ name, file, loop }) => {
          fbxLoader.load(
            file,
            (animationFbx) => {
              if (disposed || !mixer || animationFbx.animations.length === 0) return;

              const clip = animationFbx.animations[0].clone();
              const action = mixer.clipAction(clip);
              action.setLoop(loop, loop === THREE.LoopOnce ? 1 : Infinity);

              if (loop === THREE.LoopOnce) {
                action.clampWhenFinished = true;
              }

              actions[name] = action;
              console.log("JURIX ANIMATION LOADED:", name, clip.name);

              if (modeRef.current === name) {
                playMode(name);
              }
            },
            undefined,
            (error) => console.error("Failed to load animation:", file, error)
          );
        });

        if (modeRef.current !== "idle" && actions[modeRef.current]) {
          playMode(modeRef.current);
        }
      },
      undefined,
      (error) => console.error("Failed to load Jurix FBX model:", error)
    );

    let lastFrameTime = 0;
    const frameInterval = 1000 / 30;

    const animate = (timestamp: number) => {
      if (disposed) return;
      animId = requestAnimationFrame(animate);

      if (timestamp - lastFrameTime < frameInterval) return;

      const delta = Math.min(clock.getDelta(), 0.05);
      lastFrameTime = timestamp;
      mixer?.update(delta);
      renderer.render(scene, camera);
    };
    animId = requestAnimationFrame(animate);

    const handleResize = () => {
      const w = container.clientWidth || window.innerWidth;
      const h = container.clientHeight || window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };

    window.addEventListener("resize", handleResize);

    return () => {
      disposed = true;
      window.removeEventListener("resize", handleResize);
      cancelAnimationFrame(animId);
      mixer?.stopAllAction();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }, []);

  useEffect(() => {
    // Animation changes are handled as each action becomes available.
  }, [mode]);

  return (
    <div className="relative w-full h-full flex items-center justify-center pointer-events-none">
      <div ref={mountRef} className="w-full h-full pointer-events-auto" />
    </div>
  );
};





